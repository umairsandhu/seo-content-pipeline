# Copy to .env and fill in. .env is gitignored — NEVER commit real values.
# Generated from the integrations registry (seo_agent/integrations.py).
# Leave a line blank to keep that capability disabled (everything degrades).

# ── Required — core data ──
# DataForSEO: Keyword volume, SERP + People-Also-Ask, backlinks, trends, ranked keywords
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── Recommended ──
# Google PageSpeed / CrUX: Core Web Vitals — Lighthouse lab + real-user field data
PAGESPEED_API_KEY=

# ── Optional ──
# Anthropic (Claude): Headless content drafting (NOT needed when an agent drives the skill)
ANTHROPIC_API_KEY=
# OpenAI: Headless content drafting (alternative to Anthropic)
OPENAI_API_KEY=
# WordPress: Publish drafts
WP_USER=
WP_APP_PASSWORD=
# Webflow: Publish drafts
WEBFLOW_TOKEN=
# Ghost: Publish drafts
GHOST_ADMIN_KEY=

# GSC uses a service-account JSON file (set `gsc_credentials` in config.json), not env.
# Content drafting needs NO key when an agent drives the skill (agent writes it).
# Server logs: set `logs.path` in config.json (a file path, not a secret).
# Optional switches (not secrets): SEO_EMBEDDINGS=1 · SEO_CONFIG=config.json
